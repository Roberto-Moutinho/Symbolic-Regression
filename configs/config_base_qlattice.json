{
  "experiment": {
    "budget": {
      "max_evaluations": 200000,
      "max_time_seconds": 3600
    },
    "cross_validation": {
      "n_folds": 5,
      "shuffle": true,
      "seeds": [
        42,
        43,
        44,
        45,
        46
      ]
    },
    "final_seeds": [
      100,
      101,
      102,
      103,
      104,
      105,
      106,
      107,
      108,
      109
    ]
  },
  "operator_sets": {
    "C1": {
      "binary_operators": [
        "+",
        "-",
        "*",
        "/"
      ],
      "unary_operators": []
    },
    "C2": {
      "binary_operators": [
        "+",
        "-",
        "*",
        "/",
        "^"
      ],
      "unary_operators": [
        "exp",
        "log",
        "sqrt"
      ]
    }
  },
  "algorithm": "QLattice",
  "parameters": {
    "total_models": 200000,
    "models_per_sample": 10,
    "threads": 1
  },
  "tuning_space": {
    "total_models": 200000,
    "models_per_sample": {
      "min": 1,
      "max": 50
    },
    "threads": {
      "min": 1,
      "max": "all_available",
      "note": "Fixar no protocolo para comparação justa"
    }
  },
  "protocol_notes": {
    "tuning_repetitions_per_fold": 5,
    "tuning_total_executions_per_dataset_scenario_algorithm": 25,
    "tuning_datasets": [
      "chemical_2_competition_train.csv",
      "friction_dyn_one-hot_train.csv",
      "nasa_battery_1_10min_train.csv",
      "nikuradse_1_train.csv"
    ],
    "selection_metric": "mean_validation_R2",
    "tie_break": "lower_expression_complexity",
    "preserve_all_trials": true,
    "preserve_individual_fold_seed_results": true
  }
}
